// Device-owned QTI thermal HAL for the SM7125 4.14 kernel.
cc_binary {
    name: "android.hardware.thermal-service.realme_sm7125",
    stem: "android.hardware.thermal-service.qti",
    overrides: ["android.hardware.thermal-service.qti"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal-service.qti.rc"],
    vintf_fragments: ["android.hardware.thermal-service.qti.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.thermal-V1-ndk",
        "libcutils",
        "libutils",
        "liblog",
    ],
    srcs: [
        "service.cpp",
        "thermal.cpp",
        "thermalConfig.cpp",
        "thermalCommon.cpp",
        "thermalUtils.cpp",
        "thermalMonitor.cpp",
    ],
    header_libs: ["liblog_headers", "libcutils_headers"],
    cflags: ["-Wno-unused-parameter", "-Wno-unused-variable", "-fexceptions"],
}
