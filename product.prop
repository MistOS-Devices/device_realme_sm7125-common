# Display
debug.sf.hw=0
debug.egl.hw=0
debug.sf.latch_unsignaled=1
debug.mdpcomp.logs=0
vendor.gralloc.disable_ubwc=0
vendor.display.disable_scaler=0
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.comp_mask=0
debug.sf.disable_client_composition_cache=1
vendor.display.disable_rotator_ubwc=1
vendor.display.disable_layer_stitch=0
vendor.display.disable_hw_recovery_dump=1
vendor.display.disable_rotator_downscale=1
vendor.display.idle_time=0
vendor.display.idle_time_inactive=0
vendor.display.disable_metadata_dynamic_fps=1

# LMKD
ro.config.low_ram=false
ro.lmk.log_stats=false
ro.lmk.kill_heaviest_task=true
# Was 100 (= "swap always low") which made lmkd kill apps instead of swapping, leaving
# zram unused while apps thrashed. 10 = treat swap low only under ~10% free, so the
# kernel actually fills zram before lmkd starts killing.
ro.lmk.swap_free_low_percentage=10

# LMK tuning (AOSP lmkd, Android 16). Only properties the AOSP binary reads are
# listed; the QTI-only knobs (enable_watermark_check, use_psi, enable_userspace_lmk,
# super_critical, psi_scrit_complete_stall_ms, direct_reclaim_pressure,
# reclaim_scan_threshold, enhance_batch_kill) are not read by AOSP lmkd and were dropped.
ro.lmk.filecache_min_kb=153600
ro.lmk.stall_limit_critical=40
ro.lmk.use_new_strategy=true
ro.lmk.use_minfree_levels=false
ro.lmk.psi_partial_stall_ms=70
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=100
# lmkd's fallback path kills a cached app whenever a PSI event arrives while free
# memory is below the kernel's high watermark, which on this 4.14 kernel is the
# normal state during any reclaim. 950 is CACHED_APP_LMK_FIRST_ADJ, the line from
# which ActivityManager marks cached apps as "kill these first": the ~10 most
# recently used cached apps (adj 900-945) are no longer eligible for that path,
# older ones still are. Thrashing, low-swap and stall based kills are unaffected.
# Measured: stock killed 65 apps/3min under load and kept 2-3; 1000 kept
# everything (106 cached) but thrashed 6GB refaults/5min; 950 culls only the
# stale tail and pressure settles.
ro.lmk.lowmem_min_oom_score=950
# AOSP default is 100; the previous 50 let lmkd kill again before the first
# victim had released its memory.
ro.lmk.kill_timeout_ms=1000

# Incremental FS
ro.incremental.enable=1


# Inherited low-RAM (Android Go) flag that disables HW-accelerated rendering -> forces
# slow software/CPU paths for window animations and burns battery. Wrong for 8GB/Adreno 618.
# (Was in vendor.prop, where vendor_init is denied setting it.)
ro.config.avoid_gfx_accel=false

# Fling
ro.min.fling_velocity=160
ro.max.fling_velocity=20000
ro.vendor.qti.cgroup_follow.enable=true
persist.vendor.qti.inputopts.enable=true
persist.vendor.qti.inputopts.movetouchslop=0.6
ro.qcom.adreno.qgl.ShaderStorageImageExtendedFormats=0