# FW Update
genfscon proc /fastchg_fw_update              u:object_r:proc_fw_update:s0

genfscon proc /ui_soc_decimal              u:object_r:proc_decimal:s0

# Label only the mode control, not the whole sysfs kernel subtree.
genfscon sysfs /kernel/kprofiles/kp_mode u:object_r:vendor_sysfs_kprofiles:s0

# Physical wakeup-source statistics consumed read-only by system_suspend.
genfscon sysfs /devices/platform/soc/a600000.ssusb/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/soc:gpio_keys/wakeup u:object_r:sysfs_wakeup:s0
