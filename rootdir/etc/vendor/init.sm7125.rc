import /vendor/etc/init/hw/init.${ro.build.product}.rc

on init
    # Only trusted system apps may select manual kernel profiles.
    chown root system /sys/kernel/kprofiles/kp_mode
    chmod 0660 /sys/kernel/kprofiles/kp_mode


    # Group floors complement ADPF; keep every group maximum unrestricted.
    chown system system /dev/cpuctl/background/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/background/cpu.uclamp.max
    write /dev/cpuctl/background/cpu.uclamp.max 100
    chown system system /dev/cpuctl/background/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/background/cpu.uclamp.min
    write /dev/cpuctl/background/cpu.uclamp.min 0
    chown system system /dev/cpuctl/system/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/system/cpu.uclamp.max
    write /dev/cpuctl/system/cpu.uclamp.max 100
    chown system system /dev/cpuctl/system/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/system/cpu.uclamp.min
    write /dev/cpuctl/system/cpu.uclamp.min 0
    chown system system /dev/cpuctl/system-background/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/system-background/cpu.uclamp.max
    write /dev/cpuctl/system-background/cpu.uclamp.max 100
    chown system system /dev/cpuctl/system-background/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/system-background/cpu.uclamp.min
    write /dev/cpuctl/system-background/cpu.uclamp.min 0
    chown system system /dev/cpuctl/foreground/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/foreground/cpu.uclamp.max
    write /dev/cpuctl/foreground/cpu.uclamp.max 100
    chown system system /dev/cpuctl/foreground/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/foreground/cpu.uclamp.min
    write /dev/cpuctl/foreground/cpu.uclamp.min 0
    chown system system /dev/cpuctl/foreground_window/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/foreground_window/cpu.uclamp.max
    write /dev/cpuctl/foreground_window/cpu.uclamp.max 100
    chown system system /dev/cpuctl/foreground_window/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/foreground_window/cpu.uclamp.min
    write /dev/cpuctl/foreground_window/cpu.uclamp.min 6.25
    chown system system /dev/cpuctl/top-app/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/top-app/cpu.uclamp.max
    write /dev/cpuctl/top-app/cpu.uclamp.max 100
    chown system system /dev/cpuctl/top-app/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/top-app/cpu.uclamp.min
    write /dev/cpuctl/top-app/cpu.uclamp.min 12.50
    chown system system /dev/cpuctl/rt/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/rt/cpu.uclamp.max
    write /dev/cpuctl/rt/cpu.uclamp.max 100
    chown system system /dev/cpuctl/rt/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/rt/cpu.uclamp.min
    write /dev/cpuctl/rt/cpu.uclamp.min 0
    chown system system /dev/cpuctl/camera-daemon/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/camera-daemon/cpu.uclamp.max
    write /dev/cpuctl/camera-daemon/cpu.uclamp.max 100
    chown system system /dev/cpuctl/camera-daemon/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/camera-daemon/cpu.uclamp.min
    write /dev/cpuctl/camera-daemon/cpu.uclamp.min 0
    chown system system /dev/cpuctl/nnapi-hal/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/nnapi-hal/cpu.uclamp.max
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.max 100
    chown system system /dev/cpuctl/nnapi-hal/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/nnapi-hal/cpu.uclamp.min
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.min 0
    chown system system /dev/cpuctl/dex2oat/cpu.uclamp.max
    chmod 0664 /dev/cpuctl/dex2oat/cpu.uclamp.max
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 100
    chown system system /dev/cpuctl/dex2oat/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/dex2oat/cpu.uclamp.min
    write /dev/cpuctl/dex2oat/cpu.uclamp.min 0

    # Keep unhinted RT tasks on WALT demand; ADPF supplies explicit floors.
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0

    # Update Fastchg FW
    chmod 0660 /proc/fastchg_fw_update
    chown system system /proc/fastchg_fw_update
    write /proc/fastchg_fw_update 1

on fs
    mkdir /mnt/vendor/oppo_product 0771 system system
    mkdir /mnt/vendor/oppo_version 0771 system system
    mount ext4 /dev/block/mapper/version.${ro.vendor.version_variant} /mnt/vendor/oppo_version ro
    mount ext4 /dev/block/mapper/oppo_product /mnt/vendor/oppo_product ro

on boot
    # ZRAM needs no disk-style swap readahead. vendor_init can write this
    # node; the post-boot shell domain cannot.
    write /proc/sys/vm/page-cluster 0

    # Disable edge limit control interface
    chmod 0660 /proc/touchpanel/oplus_tp_limit_enable
    chmod 0660 /proc/touchpanel/oplus_tp_direction
    chown system system /proc/touchpanel/oplus_tp_limit_enable
    chown system system /proc/touchpanel/oplus_tp_direction
    write /proc/touchpanel/oplus_tp_limit_enable 0
    write /proc/touchpanel/oplus_tp_direction 1

    # Fix permissions of double tap node
    chown system system /proc/touchpanel/double_tap_enable
    chmod 0644 /proc/touchpanel/double_tap_enable

    # Vibrator node
    chown system system /sys/class/leds/vibrator/vmax_mv
    chmod 0644 /sys/class/leds/vibrator/vmax_mv

on property:ro.boot.product.hardware.sku=nfc
    start secure_element_hal_service
    start vendor.nfc_hal_service

service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc@1.2-service
    override
    disabled
    class hal
    user nfc
    group nfc

service prop-adap-core-gsi /vendor/bin/self-init gsicore
    class core
    user root
    group root system radio
    oneshot
    override
    disabled

service prop-adap-main-gsi /vendor/bin/self-init gsimain
    class main
    user root
    group root system radio
    oneshot
    override
    disabled
